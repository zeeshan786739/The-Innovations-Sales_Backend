# =============================================================================
# Leads Tool CRM — Backend API
# Copy to backend/.env and fill in real values.
# =============================================================================

# Server
PORT=5000
NODE_ENV=development

# CORS — must match the Vite frontend URL (see root .env.example)
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK (download from Firebase Console → Project Settings → Service Accounts)
FIREBASE_PROJECT_ID=PASTE_FIREBASE_PROJECT_ID_HERE
FIREBASE_CLIENT_EMAIL=PASTE_FIREBASE_CLIENT_EMAIL_HERE
FIREBASE_PRIVATE_KEY="PASTE_FIREBASE_PRIVATE_KEY_HERE"

# Custom team-member session (use a long random string for JWT_SECRET)
JWT_SECRET=PASTE_A_LONG_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=8h
COOKIE_NAME=leads_tool_session
